# Backend API base URL (proxied to http://localhost:5000 in dev via vite.config.js)
VITE_API_BASE_URL=/api

# Default mode: "api" tries Express backend first, "mock" uses browser localStorage only
VITE_DEFAULT_BACKEND_MODE=api

# When true, failed API calls automatically fall back to mock data
VITE_API_FALLBACK=true

# Default password used for backend login/register when UI does not collect one (matches seed data)
VITE_DEFAULT_PASSWORD=Password123
