# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/Guesthouse_db?schema=public"

# Authentication secrets: generate independent random values for each secret.
JWT_SECRET="replace-with-at-least-32-random-bytes"
RESET_TOKEN_SECRET="replace-with-a-different-random-secret"
RESET_CODE_SECRET="replace-with-another-random-secret"

# Frontend origin and API port
FRONTEND_URL="http://localhost:5175"
BACKEND_URL="http://localhost:5000"
PORT=5000

# Existing platform integrations
CHAPA_SECRET_KEY=""
CHAPA_PUBLIC_KEY=""
CHAPA_ENCRYPTION_KEY=""
CHAPA_WEBHOOK_SECRET=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Password-reset delivery. Configure a verified Resend sender for email and/or Africa's Talking for SMS.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Guesthouse Reservation <no-reply@your-verified-domain.com>"
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""
DISPOSABLE_EMAIL_DOMAINS="mailinator.com,tempmail.com,10minutemail.com,guerrillamail.com"

# OpenAI API key for the backend guesthouse assistant
OPENAI_API_KEY=""

# Telegram BotFather token. Keep the real token in this backend .env only.
TELEGRAM_BOT_TOKEN=""
# Telegram bot username without @; used to create secure account-link URLs.
TELEGRAM_BOT_USERNAME=""
# Optional public HTTPS webhook endpoint, e.g. https://api.example.com/api/telegram/webhook.
# Leave blank to use long polling for local development.
TELEGRAM_WEBHOOK_URL=""
# Required when TELEGRAM_WEBHOOK_URL is set; use a random 1-256 character token.
TELEGRAM_WEBHOOK_SECRET=""
# Telegram Login client ID from BotFather > Login Widget.
TELEGRAM_LOGIN_CLIENT_ID=""
# Optional internal URL used by the bot to call this server's existing APIs.
# Defaults to http://127.0.0.1:<PORT>.
TELEGRAM_API_BASE_URL=""
