# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/Guesthouse_db?schema=public"

# JWT secret for authentication tokens (change in production)
JWT_SECRET="guesthouse_secret_key"

# OpenAI API key for the backend guesthouse assistant
OPENAI_API_KEY=""

# Telegram BotFather token. Keep the real token in this backend .env only.
TELEGRAM_BOT_TOKEN=""
# Telegram bot username without @; used to create secure account-link URLs.
TELEGRAM_BOT_USERNAME=""
# Optional internal URL used by the bot to call this server's existing APIs.
# Defaults to http://127.0.0.1:<PORT>.
TELEGRAM_API_BASE_URL=""

# Server port (default: 5000)
PORT=5000
