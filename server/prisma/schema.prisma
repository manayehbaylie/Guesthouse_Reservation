generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  fullName String
  email    String @unique
  password String
  phone    String @unique
  role     Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guesthouses      Guesthouse[]      @relation("OwnerGuesthouses")
  reservations     Reservation[]     @relation("GuestReservations")
  notifications    Notification[]
  staffAssignments StaffAssignment[]
  reviews          Review[]          @relation("GuestReviews")
}

enum Role {
  GUEST
  OWNER
  RECEPTIONIST
  ADMIN
}

model Guesthouse {
  id          Int              @id @default(autoincrement())
  name        String
  address     String
  city        String
  description String
  image       String?
  status      GuesthouseStatus @default(PENDING)

  rejectionReason String?

  ownerId Int
  owner   User @relation("OwnerGuesthouses", fields: [ownerId], references: [id], onDelete: Restrict)

  rooms            Room[]
  staffAssignments StaffAssignment[]
  reviews          Review[]          @relation("GuesthouseReviews")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([city])
}

model Room {
  id Int @id @default(autoincrement())

  roomNumber        String
  roomType          RoomType
  price             Float
  capacity          Int
  available         Boolean               @default(true)
  maintenanceStatus RoomMaintenanceStatus @default(AVAILABLE)

  guesthouseId Int
  guesthouse   Guesthouse @relation(fields: [guesthouseId], references: [id], onDelete: Restrict)

  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guesthouseId, roomNumber])
  @@index([guesthouseId])
}

enum RoomType {
  SINGLE
  DOUBLE
  TWIN
  FAMILY
  SUITE
}

enum RoomMaintenanceStatus {
  AVAILABLE
  UNAVAILABLE
  CLEANING
  MAINTENANCE
}

enum GuesthouseStatus {
  PENDING
  APPROVED
  REJECTED
}

model Reservation {
  id Int @id @default(autoincrement())

  checkIn  DateTime
  checkOut DateTime

  status ReservationStatus @default(PENDING)

  guestId Int
  roomId  Int

  guest User @relation("GuestReservations", fields: [guestId], references: [id], onDelete: Restrict)
  room  Room @relation(fields: [roomId], references: [id], onDelete: Restrict)

  payment Payment?
  review  Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guestId])
  @@index([roomId])
  @@index([status])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

model Payment {
  id Int @id @default(autoincrement())

  amount Float

  method PaymentMethod
  status PaymentStatus

  reservationId Int         @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  accountNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  TELEBIRR
  CBE_BIRR
  CHAPA
}

model Notification {
  id Int @id @default(autoincrement())

  title   String
  message String

  isRead Boolean @default(false)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model StaffAssignment {
  id Int @id @default(autoincrement())

  guesthouseId Int
  guesthouse   Guesthouse @relation(fields: [guesthouseId], references: [id], onDelete: Cascade)

  staffId Int
  staff   User @relation(fields: [staffId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([guesthouseId, staffId])
  @@index([guesthouseId])
  @@index([staffId])
}

model Review {
  id Int @id @default(autoincrement())

  rating  Int
  comment String

  guestId Int
  guest   User @relation("GuestReviews", fields: [guestId], references: [id], onDelete: Cascade)

  guesthouseId Int
  guesthouse   Guesthouse @relation("GuesthouseReviews", fields: [guesthouseId], references: [id], onDelete: Cascade)

  reservationId Int         @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  ownerResponse String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guestId])
  @@index([guesthouseId])
  @@index([reservationId])
}
