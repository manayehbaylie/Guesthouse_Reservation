generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  fullName String
  email    String @unique
  password String
  phone    String @unique
  role     Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guesthouses  Guesthouse[]  @relation("OwnerGuesthouses")
  reservations Reservation[] @relation("GuestReservations")
}

enum Role {
  GUEST
  OWNER
  RECEPTIONIST
  ADMIN
}

model Guesthouse {
  id          Int     @id @default(autoincrement())
  name        String
  address     String
  city        String
  description String
  image       String?
  approved    Boolean @default(false)

  ownerId Int
  owner   User @relation("OwnerGuesthouses", fields: [ownerId], references: [id], onDelete: Restrict)

  rooms Room[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([city])
}

model Room {
  id Int @id @default(autoincrement())

  roomNumber String
  roomType   RoomType
  price      Decimal  @db.Decimal(10, 2)
  capacity   Int
  available  Boolean  @default(true)

  guesthouseId Int
  guesthouse   Guesthouse @relation(fields: [guesthouseId], references: [id], onDelete: Restrict)

  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guesthouseId, roomNumber])
  @@index([guesthouseId])
}

enum RoomType {
  SINGLE
  DOUBLE
  TWIN
  FAMILY
  SUITE
}

model Reservation {
  id Int @id @default(autoincrement())

  checkIn  DateTime
  checkOut DateTime

  status ReservationStatus

  guestId Int
  roomId  Int

  guest User @relation("GuestReservations", fields: [guestId], references: [id], onDelete: Restrict)

  room Room @relation(fields: [roomId], references: [id], onDelete: Restrict)

  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guestId])
  @@index([roomId])
  @@index([status])
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

model Payment {
  id Int @id @default(autoincrement())

  amount Decimal @db.Decimal(10, 2)

  method PaymentMethod

  status PaymentStatus

  reservationId Int @unique

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  TELEBIRR
  CBE_BIRR
  CHAPA
}
