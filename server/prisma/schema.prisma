generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int               @id @default(autoincrement())
  fullName           String
  email              String            @unique
  password           String
  phone              String            @unique
  role               Role
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  residentialAddress String?
  idType             String?
  idNumber           String?
  guesthouses        Guesthouse[]      @relation("OwnerGuesthouses")
  notifications      Notification[]
  reservations       Reservation[]     @relation("GuestReservations")
  reviews            Review[]          @relation("GuestReviews")
  staffAssignments   StaffAssignment[]
}

model Guesthouse {
  id               Int               @id @default(autoincrement())
  name             String
  address          String
  city             String
  description      String
  image            String?
  ownerId          Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  rejectionReason  String?
  status           GuesthouseStatus  @default(PENDING)
  owner            User              @relation("OwnerGuesthouses", fields: [ownerId], references: [id])
  reviews          Review[]          @relation("GuesthouseReviews")
  rooms            Room[]
  staffAssignments StaffAssignment[]
  notifications    Notification[]    // ✅ ADD THIS

  @@index([ownerId])
  @@index([city])
}

model Room {
  id                Int                   @id @default(autoincrement())
  roomNumber        String
  roomType          RoomType
  price             Float
  capacity          Int
  available         Boolean               @default(true)
  guesthouseId      Int
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  maintenanceStatus RoomMaintenanceStatus @default(AVAILABLE)
  reservations      Reservation[]
  guesthouse        Guesthouse            @relation(fields: [guesthouseId], references: [id])

  @@unique([guesthouseId, roomNumber])
  @@index([guesthouseId])
}

model Reservation {
  id        Int               @id @default(autoincrement())
  checkIn   DateTime
  checkOut  DateTime
  status    ReservationStatus
  guestId   Int
  roomId    Int
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  payment   Payment?
  guest     User              @relation("GuestReservations", fields: [guestId], references: [id])
  room      Room              @relation(fields: [roomId], references: [id])
  reviews   Review[]

  @@index([guestId])
  @@index([roomId])
  @@index([status])
}

model Payment {
  id            Int           @id @default(autoincrement())
  amount        Float
  method        PaymentMethod
  status        PaymentStatus
  reservationId Int           @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accountNumber String?
  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Notification {
  id             Int      @id @default(autoincrement())
  title          String
  message        String
  isRead         Boolean  @default(false)
  userId         Int
  guesthouseId   Int?
  type           String   @default("system")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guesthouse     Guesthouse? @relation(fields: [guesthouseId], references: [id])

  @@index([userId])
  @@index([guesthouseId])
  @@index([type])
}

model StaffAssignment {
  id           Int        @id @default(autoincrement())
  guesthouseId Int
  staffId      Int
  assignedAt   DateTime   @default(now())
  guesthouse   Guesthouse @relation(fields: [guesthouseId], references: [id], onDelete: Cascade)
  staff        User       @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([guesthouseId, staffId])
  @@index([guesthouseId])
  @@index([staffId])
}

model Review {
  id            Int         @id @default(autoincrement())
  rating        Int
  comment       String
  guestId       Int
  guesthouseId  Int
  reservationId Int
  ownerResponse String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  guest         User        @relation("GuestReviews", fields: [guestId], references: [id], onDelete: Cascade)
  guesthouse    Guesthouse  @relation("GuesthouseReviews", fields: [guesthouseId], references: [id], onDelete: Cascade)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([guesthouseId])
  @@index([reservationId])
}

enum Role {
  GUEST
  OWNER
  RECEPTIONIST
  ADMIN
}

enum RoomType {
  SINGLE
  DOUBLE
  TWIN
  FAMILY
  SUITE
}

enum RoomMaintenanceStatus {
  AVAILABLE
  UNAVAILABLE
  CLEANING
  MAINTENANCE
}

enum GuesthouseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  TELEBIRR
  BANK_TRANSFER
  CARD
  CHAPA
}