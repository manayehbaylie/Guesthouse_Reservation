generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int       @id @default(autoincrement())
  fullName              String
  email                 String?   @unique
  normalizedEmail       String?   @unique
  password              String
  phone                 String    @unique
  normalizedPhone       String?   @unique
  role                  Role
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  residentialAddress    String?
  idType                String?
  idNumber              String?
  telegramChatId        String?   @unique
  telegramLinkCodeHash  String?   @unique
  telegramLinkExpiresAt DateTime?
  language              String?
  termsAcceptedAt       DateTime?
  privacyPolicyAcceptedAt DateTime?

  guesthouses      Guesthouse[]      @relation("OwnerGuesthouses")
  notifications    Notification[]
  reservations     Reservation[]     @relation("GuestReservations")
  reviews          Review[]          @relation("GuestReviews")
  staffAssignments StaffAssignment[]
  communicationsSent     CommunicationMessage[] @relation("CommunicationSender")
  communicationsReceived CommunicationMessage[] @relation("CommunicationRecipient")
  auditLogs              AuditLog[]
  systemLocks            SystemLock[] @relation("SystemLockActor")
  activeSessions         ActiveSession[]
  refreshTokens          RefreshToken[]
  passwordResetCodes     PasswordResetCode[]
  blockedIpEntries       BlockedIp[]   @relation("BlockedIpActor")
  telegramAccount        TelegramAccount?
  bookingDrafts          BookingDraft[]
}

model Guesthouse {
  id              Int              @id @default(autoincrement())
  name            String
  address         String
  city            String
  description     String
  image           String?
  videoUrl        String?
  videoPublicId   String?
  subCity         String?
  woreda          String?
  phone           String?
  email           String?
  numberOfRooms   Int?
  photos          String[]         @default([])
  licenseNumber   String?
  licenseDocument String?
  ownerId         Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rejectionReason String?
  status          GuesthouseStatus @default(PENDING)
  latitude        Float?
  longitude       Float?

  owner            User              @relation("OwnerGuesthouses", fields: [ownerId], references: [id])
  reviews          Review[]          @relation("GuesthouseReviews")
  rooms            Room[]
  staffAssignments StaffAssignment[]
  notifications    Notification[]

  @@index([ownerId])
  @@index([city])
}

model Room {
  id                Int                   @id @default(autoincrement())
  roomNumber        String
  roomType          RoomType
  price             Float
  capacity          Int
  available         Boolean               @default(true)
  guesthouseId      Int
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  maintenanceStatus RoomMaintenanceStatus @default(AVAILABLE)

  reservations Reservation[]
  bookingDrafts BookingDraft[]
  images       RoomImage[]
  guesthouse   Guesthouse    @relation(fields: [guesthouseId], references: [id])

  @@unique([guesthouseId, roomNumber])
  @@index([guesthouseId])
}

model RoomImage {
  id        Int      @id @default(autoincrement())
  roomId    Int
  url       String
  publicId  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model Reservation {
  id        Int               @id @default(autoincrement())
  checkIn   DateTime
  checkOut  DateTime
  numberOfGuests Int         @default(1)
  status    ReservationStatus
  guestId   Int
  roomId    Int
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  payment Payment?
  guest   User     @relation("GuestReservations", fields: [guestId], references: [id])
  room    Room     @relation(fields: [roomId], references: [id])
  reviews Review[]

  @@index([guestId])
  @@index([roomId])
  @@index([status])
}

model Payment {
  id            Int           @id @default(autoincrement())
  amount        Float
  method        PaymentMethod
  status        PaymentStatus
  reservationId Int?          @unique
  bookingDraftId Int?         @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accountNumber String?
  telegramNotifiedAt DateTime? @map("telegram_notified_at")
  chapaTxRef    String?       @unique

  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  bookingDraft BookingDraft? @relation(fields: [bookingDraftId], references: [id], onDelete: SetNull)

  @@index([status])
}

model BookingDraft {
  id        Int               @id @default(autoincrement())
  userId    Int
  roomId    Int
  checkIn   DateTime
  checkOut  DateTime
  guests    Int
  amount    Float
  txRef     String            @unique
  method    PaymentMethod?
  status    BookingDraftStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room    Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  payment Payment?

  @@index([userId, status])
  @@index([roomId, checkIn, checkOut])
  @@index([status, expiresAt])
  @@map("booking_drafts")
}

model Notification {
  id           Int      @id @default(autoincrement())
  title        String
  message      String
  category     String   @default("general")
  type         String   @default("system")
  isRead       Boolean  @default(false)
  userId       Int
  guesthouseId Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  guesthouse Guesthouse? @relation(fields: [guesthouseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([guesthouseId])
  @@index([type])
  @@index([category])
}

model TelegramConversation {
  chatId    String   @id @map("chat_id")
  state     Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("telegram_conversations")
}

model TelegramAccount {
  telegramId String   @id @map("telegram_id")
  userId     Int      @unique @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_accounts")
}

model CommunicationMessage {
  id          Int      @id @default(autoincrement())
  senderId    Int
  recipientId Int
  content     String
  readAt      DateTime?
  editedAt    DateTime?
  createdAt   DateTime @default(now())

  sender    User @relation("CommunicationSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("CommunicationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

model SystemSetting {
  id                       Int      @id @default(1)
  ownerRegistrationEnabled Boolean  @default(true)
  guestBookingEnabled      Boolean  @default(true)
  commissionRate           Float    @default(10)
  systemLocked             Boolean  @default(false)
  systemLockMessage        String   @default("Under maintenance, please come back later")
  updatedAt                DateTime @updatedAt
}

model SystemLock {
  id        Int      @id @default(1)
  isLocked  Boolean  @default(false) @map("is_locked")
  message   String   @default("Under maintenance, please come back later")
  lockedBy  Int?     @map("locked_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  actor User? @relation("SystemLockActor", fields: [lockedBy], references: [id], onDelete: SetNull)

  @@map("system_lock")
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String?
  identifier String
  role      String?
  ipAddress String?
  device    String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([success, createdAt])
  @@index([identifier, ipAddress, success, createdAt])
  @@map("login_attempts")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  actorName String
  actorEmail String?
  eventCode String   @default("setting_changed")
  action    String
  setting   String
  oldValue  String
  newValue  String
  method    String   @default("SYSTEM")
  path      String   @default("/api/admin/settings")
  ipAddress String?
  statusCode Int     @default(200)
  severity  String   @default("INFO")
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([setting, createdAt])
  @@map("audit_logs")
}

model ActiveSession {
  id           String    @id @default(uuid())
  tokenId      String    @unique
  userId       Int
  ipAddress    String?
  device       String?
  lastActivity DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([lastActivity])
  @@map("active_sessions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    Int
  accessTokenId String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetCode {
  id              String    @id @default(uuid())
  challengeId     String    @unique
  userId          Int
  deliveryMethod  String    @default("email")
  codeHash        String
  attempts        Int       @default(0)
  expiresAt       DateTime
  resendAvailableAt DateTime
  verifiedAt      DateTime?
  resetTokenHash  String?   @unique
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
  @@map("password_reset_codes")
}

model BlockedIp {
  ipAddress String   @id
  reason    String?
  blockedBy Int?
  createdAt DateTime @default(now())

  actor User? @relation("BlockedIpActor", fields: [blockedBy], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("blocked_ips")
}

model StaffAssignment {
  id           Int      @id @default(autoincrement())
  guesthouseId Int
  staffId      Int
  assignedAt   DateTime @default(now())

  guesthouse Guesthouse @relation(fields: [guesthouseId], references: [id], onDelete: Cascade)
  staff      User       @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([guesthouseId, staffId])
  @@index([guesthouseId])
  @@index([staffId])
}

model Review {
  id            Int      @id @default(autoincrement())
  rating        Int
  comment       String
  guestId       Int
  guesthouseId  Int
  reservationId Int
  ownerResponse String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guest       User        @relation("GuestReviews", fields: [guestId], references: [id], onDelete: Cascade)
  guesthouse  Guesthouse  @relation("GuesthouseReviews", fields: [guesthouseId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([guestId])
  @@index([guesthouseId])
  @@index([reservationId])
}

enum Role {
  GUEST
  OWNER
  RECEPTIONIST
  ADMIN
}

enum RoomType {
  SINGLE
  DOUBLE
  TWIN
  FAMILY
  SUITE
}

enum RoomMaintenanceStatus {
  AVAILABLE
  UNAVAILABLE
  CLEANING
  MAINTENANCE
}

enum GuesthouseStatus {
  PENDING
  APPROVED
  REJECTED
  INACTIVE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUND_REQUIRED
}

enum BookingDraftStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
  REFUND_REQUIRED
}

enum PaymentMethod {
  TELEBIRR
  CBE_BIRR
  EBIRR
  MPESA
  BANK_TRANSFER
  BANK_CARD
  CARD
  CHAPA
}
